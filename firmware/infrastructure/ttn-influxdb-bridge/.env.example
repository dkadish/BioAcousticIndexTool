# Copy to .env and fill in.  docker compose reads .env automatically.
# Do NOT commit .env.

# ---------------------------------------------------------------------------
# TTN  (The Things Network application server, MQTT integration)
# ---------------------------------------------------------------------------
# TTN_APP_ID: the Application ID exactly as shown in the TTN console
#   (lowercase, hyphenated, e.g. "bait-sensors"). This is NOT the AppEUI,
#   DevEUI or AppKey that live on the LoRa module.
TTN_APP_ID=your-ttn-application-id

# TTN_API_KEY: create in TTN console ->  your application  ->  API keys
#   ->  "Add API key", grant at least "Read application traffic (uplink)".
#   Starts with "NNSXS.".  This is the MQTT password.
#   (The MQTT username is derived automatically as "<TTN_APP_ID>@<TTN_TENANT>".)
TTN_API_KEY=NNSXS.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cluster the application is registered in: eu1 | nam1 | au1
TTN_REGION=eu1
# "ttn" for The Things Network Community Edition; your tenant id on TTS Cloud.
TTN_TENANT=ttn

# TTN_DEVICE_ID: restrict ingestion to a single end device (exact id from the
#   TTN console's device list). Leave blank to ingest every device in the app.
TTN_DEVICE_ID=

# ---------------------------------------------------------------------------
# InfluxDB
# ---------------------------------------------------------------------------
INFLUX_USER=admin
INFLUX_PASSWORD=change-me-min-8-chars
INFLUX_ORG=bait
INFLUX_BUCKET=bait2
# Admin token minted on first init; also used by the bridge to write.
INFLUX_TOKEN=change-me-to-a-long-random-string
